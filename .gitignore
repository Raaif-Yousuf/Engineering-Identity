# Human-subjects research data must never be committed to this repo.
# Root-anchored so this does not also match the src/ei_model/models/ package.
/data/
/models/
*.xlsx
*.csv
!tests/fixtures/*.csv
# Experiment result aggregates are safe to commit (mean/sd of R2/RMSE/MAE
# per protocol/model, feature-family importances) -- never per-participant
# rows. See docs/experiments.md.
!results/*.csv
*.pkl
*.keras
*.mat

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/

# Raw stdout/TensorFlow logs from experiment runs -- operational noise, not
# a deliverable (the aggregates in results/*.csv are what's reported).
/results/logs/

# IDE / OS junk
.idea/
.vs/
.vscode/
.DS_Store
Thumbs.db
